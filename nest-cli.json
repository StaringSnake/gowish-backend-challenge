{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/giftcards/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/giftcards/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/giftcards",
  "projects": {
    "giftcards": {
      "type": "application",
      "root": "apps/giftcards",
      "entryFile": "main",
      "sourceRoot": "apps/giftcards/src",
      "compilerOptions": {
        "tsConfigPath": "apps/giftcards/tsconfig.app.json"
      }
    },
    "stores": {
      "type": "application",
      "root": "apps/stores",
      "entryFile": "main",
      "sourceRoot": "apps/stores/src",
      "compilerOptions": {
        "tsConfigPath": "apps/stores/tsconfig.app.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    }
  }
} 